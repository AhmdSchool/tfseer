    function hideTip() {
        if (swal.getState().isOpen)
            swal.close();
        $('#tip').hide();
    }
    function showtip(str) {
        isWithLikes = (!_.isUndefined(str) && !_.isUndefined(str.likes));
        likes = {};
        if (isWithLikes) {
            likes = str.likes;
            str = str.html;
        }
        tadarsItem.innerHTML = str;
        tadarsItem.innerHTML += $('.nav-in-popup').clone().html();
        //$('.tip-text').show().html('');
        //$('#tip').removeClass('without_txt').show();
        if (_.isUndefined(str)) {
            $('#tip').removeClass('without_txt').show()
                .addClass('without_txt')
                .find('.tip-text')
                .hide();
        } else {
            J.modal('التدبرات المرتبطة بالآية',tadarsItem);
        }
        centerContainerW = $('#quran-continer').width();
        if (centerContainerW > ('336' * 2)) {
            if ((quran.page % 2) == 1)
                centerContainerW = 0;
            else
                centerContainerW = '336' * 2;
        } else
            centerContainerW *= 0.71;
        arrowX = quran.pageX - (( window.innerWidth - centerContainerW) / 2);
        //dd(centerContainerW, arrowX);
        if (arrowX > (quran.w - (quran.w * 0.1)))
            arrowX = (quran.w - (quran.w * 0.1));
        else if (arrowX < (quran.w * 0.1))
            arrowX = (quran.w * 0.1);
        elHeight = $('#tip').outerHeight();
        $('#tip').css('top', (quran.pageY - elHeight - 120));
        if (quran.pageY < 300) {
            $('#tip').css('top', quran.pageY - 80);
            $('#tip-style').html("<style>#tip:after{left: " + arrowX + "px !important;top: -18px !important;border-top-width: 0px !important;border-bottom-width: 20px !important;}</style>");
        } else
            $('#tip-style').html("<style>#tip:after{left: " + arrowX + "px !important;top: 100% !important;border-bottom-width: 0px !important;border-top-width:20px !important;}</style>");

        cloredUserLikes(likes);
    }

