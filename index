<script>
    var exportFormHtml = 0;
    $(function () {
        $('#export-btn').click(function () {

            if (exportFormHtml == 0)
                exportFormHtml = $('.export-form').get(0);
            swal({
                content: exportFormHtml,
                button: "إغلاق",
                dangerMode: true,
            });
            $('[name="export_sora_num_list"]').val(quran.sora).change();
            return false;
        });

        $('.btn-export-wagafat').click(function () {
            if (validateAyat()) {
                fromAyah = parseInt($('#from-ayah').val());
                toAyah = parseInt($("#to-ayah").val());
                tdbr_types = [];
                ayahId = $($('.index-sura-name>a')[$('[name="export_sora_num_list"] option:selected').index()]).data('ayah-id');
                $.each($('.lbl-tdbr-export-type>input:checked'), function () {
                    tdbr_types.push($(this).val());
                });
                url = '/app/api?ac=export&type=' + $('[name="export-type"]:checked').val() + '&tdbr_types=' + tdbr_types.join();
                fromAyah += ayahId - 1;
                toAyah += ayahId - 1;
                url += '&from=' + fromAyah + '&to=' + toAyah;
                Object.assign(document.createElement('a'), {target: '_blank', href: url}).click();
            }
            return false;
        });

        $('[name=export_sora_num_list]').change(function () {
            J.api({
                    ac: 'ayatList',
                    sora: $(this).val()
                },
                exportAyatList,
                'https://tadars.com/quran/api')
        });

        $('[name=export_ayat_num_list]').change(function () {
            updateAyatRange($(this).val());
        });

        
    });

    function exportAyatList(data) {
        $("[name=export_ayat_num_list] option").remove();
        counter = 1;
        $.each(data, function () {
            $("[name=export_ayat_num_list]").append('<option value="' + (counter++) + '">' + this + '</option>');
        });

        $('[name="export_ayat_num_list"]').val(quran.ayah).change();
        $("select").trigger("chosen:updated");
    }

    function updateAyatRange(fromAyah, toAyah) {
        fromAyah = parseInt(fromAyah);
        toAyah = _.isUndefined(toAyah) ? parseInt($('#to-ayah').val()) : parseInt(toAyah);
        if (toAyah > fromAyah + 9)
            toAyah = fromAyah + 9;
        else if (toAyah < fromAyah)
            toAyah = fromAyah;
        $('#from-ayah').val(fromAyah);
        $('#to-ayah').val(toAyah);
    }

    function validate(evt) {
        var theEvent = evt || window.event;

        var key;
        if (theEvent.type === 'paste') {
            key = event.clipboardData.getData('text/plain');
        } else {
            key = theEvent.keyCode || theEvent.which;
            key = String.fromCharCode(key);
        }

        var regex = /[0-9]|\./;
        if (!regex.test(key)) {
            theEvent.returnValue = false;
            if (theEvent.preventDefault) theEvent.preventDefault();
            //alert(exportMsg);
        }
    }

    function validateAyat() {
        isPdf = $('[name="export-type"]:checked').val() == 'pdf';

        fromAyah = parseInt($('#from-ayah').val());
        toAyah = parseInt($('#to-ayah').val());

        toAyahMax = ayatCount = $('[name="export_ayat_num_list"] option').length;
        exportMsg = 'يرجى إدخال قيمة رقمية بين (1) و (' + ayatCount + ')';

        if (isPdf && toAyahMax > fromAyah + 9)
            toAyahMax = fromAyah + 9;

        therIsError = false;

        if (isPdf && toAyah > toAyahMax) {
            exportMsg = 'عذراً!، لايمكن التصدير كـ pdf لوقفات أكثر من ١٠ آيات';
            therIsError = true;
        } else if (fromAyah < 1 || fromAyah > toAyahMax || toAyah > toAyahMax) {
            exportMsg = 'يرجى إدخال قيمة رقمية بين (1) و (' + toAyahMax + ')';
            therIsError = true;
        } else if (toAyah < fromAyah) {
            exportMsg = 'يرجى إدخال في حقل "الآية إلى" كقيمة رقمية بين (' + (fromAyah) + ') و (' + toAyahMax + ')';
            therIsError = true;
        }


        if (therIsError)
            alert(exportMsg);

        return !therIsError;
    }

